# By default the backend runs on its local H2 database. Uncomment and configure
# these only when using a MySQL server.
# SPRING_PROFILES_ACTIVE=mysql
# DB_URL=jdbc:mysql://localhost:3306/job_portal?createDatabaseIfNotExist=true
# DB_USERNAME=your-database-user
# DB_PASSWORD=your-private-database-password
# Used only if the separate legacy job-portal API is enabled.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
CLIENT_ORIGIN=http://localhost:5174
UPLOAD_DIR=./uploads
